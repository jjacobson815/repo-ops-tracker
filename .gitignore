node_modules/

# ---------------------------------------------------------------------------
# SQLite databases (runtime state — regenerated via `prisma migrate deploy`)
# The DB file is NOT the source of truth; prisma/schema.prisma + prisma/migrations/
# are. Never commit local/dev databases or their journal/WAL files.
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Zero-Trust: never commit secrets or environment files
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pkcs12
id_rsa

# ---------------------------------------------------------------------------
# OS / IDE clutter
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo

# ---------------------------------------------------------------------------
# Build outputs / artifacts (generated locally or by CI)
# ---------------------------------------------------------------------------
dist/
build/
out/
*.exe
*.dll
*.class

# Logs / coverage
*.log
npm-debug.log*
coverage/
.nyc_output/
.obsidian/
# Added by code-review-graph
.code-review-graph/

# ---------------------------------------------------------------------------
# Playwright (test/e2e.spec.mjs — see MIGRATION-NOTES.md)
# ---------------------------------------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/

# One-shot legacy-data migration output (scripts/export-sqlite-to-bundle.mjs)
data/migration-bundles/

# ---------------------------------------------------------------------------
# PoB plan sync (scripts/pob-plan/) — persistent Playwright/Chromium profile.
# This IS the IndexedDB storage the synced board lives in; never commit it.
# ---------------------------------------------------------------------------
scripts/pob-plan/.profile/
scripts/pob-plan/.browsers/
public/pob-plan-data/

# ---------------------------------------------------------------------------
# Local JSON data store (legacy server runtime state; *.db already ignored
# above). The source of truth is now client-side IndexedDB — never commit
# local/dev data.
# ---------------------------------------------------------------------------
data/*.json

# ---------------------------------------------------------------------------
# Local scratch / debug dumps and editor backups
# ---------------------------------------------------------------------------
ERR
*.diff
*.bak
